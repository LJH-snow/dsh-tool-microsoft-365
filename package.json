{
  "name": "@libai168/dsh-tool-microsoft-365",
  "description": "Read-only Microsoft 365 tools for DeepSeek Harness using Microsoft Graph v1.0",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "README.zh.md",
    "DEVELOPMENT.md",
    "examples",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "awesome-dsh-plugin",
    "cordis",
    "microsoft-365",
    "microsoft-graph",
    "outlook",
    "calendar",
    "onedrive",
    "teams",
    "agent",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LJH-snow/dsh-tool-microsoft-365.git"
  },
  "homepage": "https://github.com/LJH-snow/dsh-tool-microsoft-365#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@types/node": "^22.20.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  }
}
